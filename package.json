{
  "name": "stitch-github-manager",
  "version": "1.0.0",
  "description": "Desktop GitHub and repo manager sorted by energy levels",
  "main": "main.go",
  "scripts": {
    "dev": "cd backend && mkdir -p dist && touch dist/.gitkeep && wails dev",
    "dev:client": "vite --config client/vite.config.mjs",
    "build": "cd backend && mkdir -p dist && touch dist/.gitkeep && wails build",
    "build:client": "vite build --config client/vite.config.mjs",
    "test": "cd backend && mkdir -p dist && touch dist/.gitkeep && go test ./..."
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0",
    "lucide-react": "^1.49.0",
    "monaco-editor": "^0.52.2",
    "radix-ui": "^1.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=24"
  }
}
