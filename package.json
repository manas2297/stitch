{
  "name": "stitch-github-manager",
  "version": "1.0.0",
  "description": "Local GitHub and repo manager sorted by energy levels",
  "main": "main.go",
  "scripts": {
    "dev:server": "go run github.com/air-verse/air@latest -c .air.toml",
    "dev:client": "vite --config client/vite.config.js",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build --config client/vite.config.js",
    "build:server": "go build -o stitch-backend .",
    "build": "npm run build:client && npm run build:server",
    "start": "./stitch-backend"
  },

  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.3",
    "nodemon": "^3.1.14",
    "vite": "^6.4.3"
  }
}
